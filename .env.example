# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# OpenTelemetry Configuration for Kubiks
VITE_OTEL_SERVICE_NAME=m2training
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.kubiks.app/v1/traces
VITE_OTEL_EXPORTER_OTLP_HEADERS=x-kubiks-key=YOUR_KUBIKS_API_KEY
